\providecommand\hyper@newdestlabel[2]{}
\providecommand\HyperFirstAtBeginDocument{\AtBeginDocument}
\HyperFirstAtBeginDocument{\ifx\hyper@anchor\@undefined
\global\let\oldcontentsline\contentsline
\gdef\contentsline#1#2#3#4{\oldcontentsline{#1}{#2}{#3}}
\global\let\oldnewlabel\newlabel
\gdef\newlabel#1#2{\newlabelxx{#1}#2}
\gdef\newlabelxx#1#2#3#4#5#6{\oldnewlabel{#1}{{#2}{#3}}}
\AtEndDocument{\ifx\hyper@anchor\@undefined
\let\contentsline\oldcontentsline
\let\newlabel\oldnewlabel
\fi}
\fi}
\global\let\hyper@last\relax 
\gdef\HyperFirstAtBeginDocument#1{#1}
\providecommand\HyField@AuxAddToFields[1]{}
\providecommand\HyField@AuxAddToCoFields[2]{}
\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces Training and evaluation provenance of every evaluated checkpoint (one seed per condition). Steps are optimizer steps. Evaluation dates are those of the evaluation log, in local time (UTC+7).}}{4}{table.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {S2}{\ignorespaces Collision events of \texttt  {Balanced\mbox  {-}6400} and \texttt  {Hazard\mbox  {-}heavy\mbox  {-}6400} on the routes with and without blocked time of \texttt  {Balanced\mbox  {-}6400}, per pass. Events are leaderboard collision records merged by actor. n is the number of routes; "Events" and "Per route" are collision events and events per route, \texttt  {Balanced\mbox  {-}6400} / \texttt  {Hazard\mbox  {-}heavy\mbox  {-}6400}. The last column is the paired difference per route (\texttt  {Balanced\mbox  {-}6400} minus \texttt  {Hazard\mbox  {-}heavy\mbox  {-}6400}) with its 95 \% BCa interval.}}{7}{table.2}\protected@file@percent }
