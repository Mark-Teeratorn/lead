\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Evaluation Protocol and Disclosures}{10}{subsection.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Inference and control pipeline in closed loop: camera images, ego history and navigation command; frozen VLM backbone; fine-tuned flow-matching action expert; 64-waypoint trajectory with extent L; target speed and standstill gate; PID controller; CARLA vehicle, with ego-state feedback.}}{11}{figure.1}\protected@file@percent }
\citation{ref3}
\citation{ref3}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Same-Input Replay}{12}{subsection.4.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces The measures used in this paper: what each counts, at which level, and where it is defined.}}{13}{table.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Sampled plans on two replayed states (illustrative). Left: front camera frame of the state with its scenario type, speed and navigation command; the night frame of panel (b) is brightened for print. Right: extent L of the 16 plans sampled by Golden-6400, Flooded-6400 and Decoupling-6400 on that state, sorted by L. Open markers are stay-put plans (L \ensuremath  {<} 0.64 m, dotted line); the dashed line is the 1.5 m threshold of a near-stationary plan. Panel (a) is the state closest to the mean difference in stay-put plans between Flooded-6400 and Golden-6400 and panel (b) the state with the largest difference; both follow a rule fixed in advance. The planned paths are nearly straight (lateral displacement below 0.15 m), so extents are shown and not paths. The plans were computed again for this figure in new processes with the replay code and seeds unchanged, and on these two states their extents agree with the stored ones.}}{14}{figure.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}The Matched Pair at 6,400 Samples}{15}{subsection.4.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \texttt  {Golden\mbox  {-}6400} / \texttt  {Flooded\mbox  {-}6400} on 44 routes with the default controller, first pass. Mean of per-route values, with the paired difference and its 95 \% BCa interval in parentheses. F1 and F2 were specified before the runs; all other rows are descriptive. For reference, the unadapted policy (\texttt  {Base\mbox  {-}Rerun}, one pass) had near-stationary plans in 13.24 \% of steps and a standstill time of 36.28 \%. The three plan rows at 0.5 m/s or less use the 35 routes with at least 20 such steps in both arms.}}{16}{table.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Empirical cumulative distribution of the predicted trajectory extent L over all logged steps of the 44 routes: Golden-6400 and Flooded-6400 (both passes pooled), Decoupling-6400 and the unadapted policy (Base-Rerun; one pass each). Logarithmic axis; values below 0.1 m are shown at 0.1 m. Dotted lines mark 0.64, 1.5 and 2.0 m. The curves pool the steps of all routes, so their values at 1.5 m differ from the means of per-route shares given in the text (28.04 \% and 13.24 \%), in which every route has the same weight.}}{16}{figure.3}\protected@file@percent }
\citation{ref3}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Share of steps with a near-stationary plan (L \ensuremath  {<} 1.5 m) on each of the 44 routes for Golden-6400 and Flooded-6400 as the mean of the two passes, sorted by the paired difference. Dashed lines are the 44-route means. An asterisk marks the 7 routes touched by training samples and a dagger the 20 controller-tuning routes.}}{18}{figure.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \texttt  {Golden\mbox  {-}6400} / \texttt  {Flooded\mbox  {-}6400} on 44 routes with the default controller: first pass, second pass and the per-route mean of the two passes. Mean of per-route values, with the paired difference and its 95 \% BCa interval in parentheses. R1 to R3 are the measures of the repeat rule, which is decided on the second pass alone; all other entries are descriptive. \texttt  {Base\mbox  {-}Rerun} (one pass): near-stationary plans 13.24 \%, standstill time 36.28 \%, Driving Score 42.60.}}{19}{table.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}The Matched Pair without the Standstill Gate}{20}{subsection.4.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces The 6,400-sample checkpoints on 44 routes without the standstill gate (one pass each). Columns 2 and 3: gate-off run / per-route mean of the two default passes of the same checkpoint. Column 4: \texttt  {Golden\mbox  {-}6400} / \texttt  {Flooded\mbox  {-}6400}, both without the gate. Mean of per-route values, with the paired difference and its 95 \% BCa interval in parentheses. Exploratory.}}{21}{table.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Mean standstill time of Golden-6400 and Flooded-6400 on the 44 routes under the default controller (mean of the two passes) and the gate-off controller (one pass). The hatched part of each bar is blocked time (at least 5 s commanded to accelerate without moving); the solid part is all other standstill. Error bars are 95 \% percentile bootstrap intervals over routes for the whole bar.}}{22}{figure.5}\protected@file@percent }
