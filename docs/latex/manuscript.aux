\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \texttt  {Golden\mbox  {-}6400} / \texttt  {Flooded\mbox  {-}6400} on 44 routes with the default controller, first pass. Mean of per-route values, with the paired difference and its 95 \% BCa interval in parentheses. F1 and F2 were specified before the runs; all other rows are descriptive. The three plan rows at 0.5 m/s or less use the 35 routes with at least 20 such steps in both arms.}}{14}{table.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Empirical cumulative distribution of the predicted trajectory extent L over all logged steps of the 44 routes: Golden-6400 and Flooded-6400 (both passes pooled), Decoupling-6400 and the unadapted policy (Base-Rerun; one pass each). Logarithmic axis; values below 0.1 m are shown at 0.1 m. Dotted lines mark 0.64, 1.5 and 2.0 m.}}{14}{figure.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Share of steps with a near-stationary plan (L \ensuremath  {<} 1.5 m) on each of the 44 routes for Golden-6400 and Flooded-6400 as the mean of the two passes, sorted by the paired difference. Dashed lines are the 44-route means. An asterisk marks the 7 routes touched by training samples and a dagger the 20 controller-tuning routes.}}{16}{figure.3}\protected@file@percent }
\citation{ref3}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \texttt  {Golden\mbox  {-}6400} / \texttt  {Flooded\mbox  {-}6400} on 44 routes with the default controller: first pass, second pass and the per-route mean of the two passes. Mean of per-route values, with the paired difference and its 95 \% BCa interval in parentheses. R1 to R3 are the measures of the repeat rule, which is decided on the second pass alone; all other entries are descriptive.}}{17}{table.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}The Matched Pair without the Standstill Gate}{18}{subsection.4.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces The 6,400-sample checkpoints on 44 routes without the standstill gate (one pass each). Columns 2 and 3: gate-off run / per-route mean of the two default passes of the same checkpoint. Column 4: \texttt  {Golden\mbox  {-}6400} / \texttt  {Flooded\mbox  {-}6400}, both without the gate. Mean of per-route values, with the paired difference and its 95 \% BCa interval in parentheses. Exploratory.}}{19}{table.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Mean standstill time of Golden-6400 and Flooded-6400 on the 44 routes under the default controller (mean of the two passes) and the gate-off controller (one pass). The hatched part of each bar is blocked time (at least 5 s commanded to accelerate without moving); the solid part is all other standstill. Error bars are 95 \% percentile bootstrap intervals over routes for the whole bar.}}{20}{figure.4}\protected@file@percent }
